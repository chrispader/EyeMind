{
  "name": "eyemind",
  "version": "0.0.2",
  "productName": "EyeMind App",
  "description": "Eye tracking in conceptual models",
  "main": ".out/main/index.js",
  "scripts": {
    "install-dependencies": "(cd extra/object-diagram-modeler && bun install)",
    "format": "prettier --write .",
    "lint": "eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "test": "bunx playwright test test/tests/playwright/",
    "test-temp": "bunx playwright test test/tests/playwright/import.test.ts",
    "server:setup": "cd ../EyeTrackingServer && python -m venv venv && source venv/bin/activate && pip install -r requirements.txt",
    "server:start": "cd ../EyeTrackingServer && source venv/bin/activate && python -m server"
  },
  "repository": {
    "type": "git",
    "url": ""
  },
  "keywords": [
    ""
  ],
  "author": {
    "name": "Amine Abbad-Andaloussi",
    "url": ""
  },
  "license": "MIT",
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.0",
    "@electron-toolkit/utils": "^3.0.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/vite": "^4.1.18",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "bfj": "9.1.2",
    "big-json": "3.2.0",
    "bpmn-js": "9.0.4",
    "chai": "^4.3.6",
    "cross-env": "^7.0.3",
    "dataframe-js": "",
    "detect-port": "",
    "diagram-js": "8.2.2",
    "electron-mocha": "",
    "electron-squirrel-startup": "^1.0.1",
    "immer": "^11.1.0",
    "jquery": "^3.3.1",
    "jsdom": "",
    "lodash": "",
    "mocha": "^10.0.0",
    "net": "^1.0.2",
    "npm-run-all": "^4.1.3",
    "playwright": "^1.25.2",
    "postcss": "^8.5.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-svg-loader": "",
    "request-promise": "",
    "stream": "^0.0.3",
    "tailwindcss": "^4.1.18",
    "tls": "",
    "tree-kill": "",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@babel/core": "^7.20.5",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.2.0",
    "@electron/fuses": "^2.0.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@playwright/test": "^1.26.0",
    "@trivago/prettier-plugin-sort-imports": "^5.2.1",
    "@types/big-json": "^3.2.5",
    "@types/dataframe-js": "^1.4.3",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/eslint__js": "^8.42.3",
    "@types/lodash": "^4.17.14",
    "@types/request-promise": "^4.1.51",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.48.2",
    "@vitejs/plugin-react": "^4.3.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "electron": "^39.0.0",
    "electron-devtools-installer": "^4.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^8.10.0",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-import": "^2.25.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react-compiler": "^19.1.0-rc.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "path-browserify": "^1.0.1",
    "prettier": "^3.4.0",
    "react-router": "^7.3.0",
    "request": "^2.88.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.4",
    "vite": "^5.4.0"
  }
