{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/types/**/*",
    "src/renderer/**/*",
    "src/preload/*.d.ts",
    "src/main/listeners"
  ],
  "compilerOptions": {
    "composite": true,
    "baseUrl": ".",
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "paths": {
      "*": ["node_modules/*"],
      "@/*": ["src/*"],
      "@renderer/*": ["src/renderer/src/*"]
    }
  }
}
